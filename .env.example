# Copy to .env and customize (all settings are optional — secrets auto-generate)
#
# SECRET_KEY — auto-generated on first run, persisted to $BASE_DATA_DIR/secret_key
# DATABASE_URL — auto-constructed from $BASE_DATA_DIR/db_password + DB_* vars below
#
# To set explicitly:
#   SECRET_KEY=<python -c "import secrets; print(secrets.token_hex(32))">
#   DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
#
# DB_USER=nova
# DB_NAME=novadb
# DB_HOST=localhost
# DB_PORT=5432
REDIS_URL=redis://localhost:6379/0

# UI sandbox (docker-compose.yml) host bind + ports — loopback-only by
# default; change the ports when 8000/5173/5432 are taken on this machine,
# e.g. by an SSH tunnel to a deployed instance. On Linux hosts you can keep
# the port numbers and move the sandbox to another loopback address instead
# (e.g. NOVA_VE_SANDBOX_BIND=127.0.0.2); macOS only has 127.0.0.1 on lo0.
# NOVA_VE_SANDBOX_BIND=127.0.0.1
# NOVA_VE_SANDBOX_BACKEND_PORT=8000
# NOVA_VE_SANDBOX_FRONTEND_PORT=5173
# NOVA_VE_SANDBOX_DB_PORT=5432
